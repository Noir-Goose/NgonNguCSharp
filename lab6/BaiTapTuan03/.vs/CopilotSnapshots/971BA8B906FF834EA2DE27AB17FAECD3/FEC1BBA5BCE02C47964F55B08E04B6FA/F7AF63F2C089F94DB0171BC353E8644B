        private void ThucHienTaoTonKho()
        {
            string connStr = "Server=localhost,1433;Database=QLCuaHang;User Id=sa;Password=YourStrong@Passw0rd;";
            using (SqlConnection conn = new SqlConnection(connStr))
            {
                try
                {
                    conn.Open();
                    // Câu lệnh tạo tồn kho ngày hôm nay dựa vào ngày hôm qua
                    string query = @"
                        INSERT INTO TONKHO (Ngay, MaSP, SLTon, TongSLNhap, TongSLBan)
                        SELECT
                            CAST(GETDATE() AS DATE),
                            sp.MaSP,
                            ISNULL(tk.SLTon, 0) + ISNULL(tk.TongSLNhap, 0) - ISNULL(tk.TongSLBan, 0),
                            0,
                            0
                        FROM SANPHAM sp
                        LEFT JOIN TONKHO tk
                            ON sp.MaSP = tk.MaSP
                            AND tk.Ngay = DATEADD(day, -1, CAST(GETDATE() AS DATE))
                        WHERE NOT EXISTS (
                            SELECT 1
                            FROM TONKHO
                            WHERE Ngay = CAST(GETDATE() AS DATE)
                                AND MaSP = sp.MaSP
                        );";

                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        int rows = cmd.ExecuteNonQuery();
                        MessageBox.Show($"Đã tạo dữ liệu tồn kho thành công cho {rows} sản phẩm!", "Thông báo");
                    }
                }
}
                catch (Exception ex)
                {
                    MessageBox.Show("Lỗi tạo tồn kho: " + ex.Message);
                }
            }
        }
    }
