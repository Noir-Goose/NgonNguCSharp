        /// <summary>
        /// Parses comma-separated input to integers
        /// </summary>
        private bool TryParseArray(string input, out int[] result)
        {
            result = Array.Empty<int>();
            if (string.IsNullOrWhiteSpace(input))
            {
                MessageBox.Show("Please enter array values separated by commas.",
                    "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            try
            {
                result = input.Split(',')
                    .Select(s => s.Trim())
                    .Where(s => !string.IsNullOrEmpty(s))
                    .Select(int.Parse)
                    .ToArray();

                if (result.Length == 0)
                {
                    MessageBox.Show("Please enter at least one integer value.",
                        "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return false;
                }

                return true;
            }
            catch (FormatException)
            {
                MessageBox.Show("Invalid input. Please enter integers separated by commas.\nExample: 1, 2, 3, 4, 5",
                    "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return false;
            }
        }

